{
  "expo": {
    "name": "Sajag",
    "slug": "sajag",
    "scheme": "sajag",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.bitflare.sajag",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6583adf9-d16c-48e3-a420-9a628ffeee58"
      }
    },
    "owner": "addy_03",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/6583adf9-d16c-48e3-a420-9a628ffeee58"
    }
  }
}
